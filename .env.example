# ---- Database -------------------------------------------------------------
POSTGRES_USER=alpago
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alpago
POSTGRES_PORT=5432
# Used directly by the API when not running under docker-compose:
# DATABASE_URL=postgresql+psycopg2://alpago:change-me@localhost:5432/alpago

# ---- API ------------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated. Set to your deployed web origin in production, not "*".
CORS_ORIGINS=*

# ---- AI layer (optional; the app works fully without it) ------------------
AI_ENABLED=true
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_ITEMS_PER_RUN=40

# ---- Allocation scoring weights (tunable without a code change) -----------
SKILL_WEIGHT_SENIOR=3.0
SKILL_WEIGHT_MID=2.0
SKILL_WEIGHT_JUNIOR=1.0
WORKLOAD_PENALTY_PER_DAY=0.15
